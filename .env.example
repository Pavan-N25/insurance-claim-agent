# ========================================================
# Multimodal Insurance Claim Triage AI Agent Configuration
# ========================================================

# Application Mode
APP_ENV=development
DEBUG=True
PORT=8000
FRONTEND_PORT=5173

# Security & Authentication
# REQUIRED: Generate a strong random secret, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS: Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Configuration
# Default uses high-performance SQLite with JSON support for instant zero-dependency local runs.
# For PostgreSQL in Docker / Production: postgresql+psycopg2://postgres:postgres@localhost:5432/insurance_claim_db
DATABASE_URL=sqlite:///./claim_agent.db

# LLM Provider Configuration: "gemini", "openai", "anthropic", or "local" (intelligent fallback engine)
LLM_PROVIDER=local
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Default Models
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Storage & Uploads
STORAGE_DIR=backend/data/uploads
MAX_FILE_SIZE_MB=25

# Business Rules & Thresholds (Can also be tuned via Admin UI)
FRAUD_FLAG_THRESHOLD=65
HIGH_VALUE_THRESHOLD_INR=100000
MIN_CONFIDENCE_AUTO_APPROVE=0.85
MAX_SLA_HOURS_CRITICAL=2
MAX_SLA_HOURS_HIGH=6
MAX_SLA_HOURS_NORMAL=24

# External APIs (Optional)
MAPS_API_KEY=
EMAIL_API_KEY=
